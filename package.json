{
  "name": "disciplinas-casi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Catálogo das disciplinas de Sistemas de Informação da UFV – Campus Rio Paranaíba, mantido pelo CASI",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
