    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.148.0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "yarn@4.11.0"
